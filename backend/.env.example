# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickr_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="super-secret-jwt-access-key-change-in-production-32-bytes"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-token-key-change-in-production-32-bytes"
REFRESH_TOKEN_EXPIRES_IN="7d"
COOKIE_SECRET="cookie-signing-secret-change-in-production-32-chars-long"

# Market Data Providers
MARKET_PROVIDER=mock # options: twelve_data | mock
TWELVE_DATA_API_KEY=demo_or_your_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_MINUTE_CREDIT_BUDGET=8
TWELVE_DATA_DAILY_CREDIT_BUDGET=800
PROVIDER_HTTP_TIMEOUT_MS=5000

# Enrichment Providers (Optional)
NEWS_PROVIDER=mock # options: alpha_vantage | mock
ALPHA_VANTAGE_API_KEY=demo_or_your_key_here

# Meaningful Change Algorithm Thresholds
CHANGE_PRICE_MODERATE_PCT=2.0
CHANGE_PRICE_HIGH_PCT=5.0
CHANGE_PRICE_VERY_HIGH_PCT=8.0
CHANGE_VOLUME_ANOMALY_RATIO=1.75
CHANGE_VOLATILITY_RATIO=1.5
ALGORITHM_VERSION="1.0.0"

# Caching TTLs (seconds)
TTL_QUOTE_LIVE=15
TTL_QUOTE_CLOSED=180
TTL_HISTORY=900
TTL_FUNDAMENTALS=86400
TTL_NEWS=600
TTL_INDICATORS=900
TTL_DASHBOARD_CHANGES=30

# Background Worker Settings
REFRESH_WORKER_INTERVAL_MS=30000
ALERT_EVAL_INTERVAL_MS=30000
